import Lake
open Lake DSL

package maglean where
  version := v!"0.2.0"
  leanOptions := #[
    ⟨`pp.unicode.fun, true⟩,
    ⟨`autoImplicit, false⟩
  ]
  extraDepTargets := #[`gitBuildInfo]

require "leanprover-community" / "mathlib" @ git "v4.36.0"

private def refreshGitBuildInfo (dir : System.FilePath) : IO Unit := do
  let commit ← try
    let out ← IO.Process.output {
      cmd := "git"
      args := #["describe", "--always", "--dirty", "--abbrev=12"]
      cwd := dir
    }
    if out.exitCode == 0 then pure out.stdout.trimAscii.toString else pure "unknown"
  catch _ =>
    pure "unknown"
  let path := dir / "MAGLean" / "BuildInfo.lean"
  let content :=
    "-- Auto-generated by lakefile.lean (gitignored).\n" ++
    "namespace MAGLean.BuildInfo\n" ++
    s!"def gitCommit : String := {repr commit}\n" ++
    "end MAGLean.BuildInfo\n"
  let existing? ←
    if ← path.pathExists then
      some <$> IO.FS.readFile path
    else
      pure none
  if existing? != some content then
    IO.FS.writeFile path content

/-- Refresh `MAGLean/BuildInfo.lean` from `git describe --always --dirty --abbrev=12`.
Rewrites the file only when the commit/dirty string changes, so incremental builds
stay fast while any commit or uncommitted working-tree change updates `git_commit`
in the compiled `maglean` binary. -/
target gitBuildInfo pkg : Unit := do
  refreshGitBuildInfo pkg.dir
  return Job.nil

@[default_target]
lean_lib MAGLean

@[default_target]
lean_exe maglean where
  root := `Main
